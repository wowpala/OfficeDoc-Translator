# API configuration (get your key from https://cloud.siliconflow.cn/account/ak)
LLM_API_KEY=your_api_key_here

# Translation model
MODEL_NAME=gemini-3-pro-high

# API endpoint
ENDPOINT=https://api.siliconflow.cn/v1

# Temperature (0.0 - 2.0)
TEMPERATURE=1

# Enable provider-specific thinking mode when supported
ENABLE_THINKING=false

# Request timeout in seconds for both connect and read
REQUEST_TIMEOUT_SECONDS=60

# Retry policy for retryable 429 / 5xx / network errors
MAX_RETRIES=4
INITIAL_BACKOFF_SECONDS=1
MAX_BACKOFF_SECONDS=20

# Minimum interval between requests to avoid burst traffic
MIN_REQUEST_INTERVAL_SECONDS=0.75

# Abort after this many exhausted translation failures in a row
CONSECUTIVE_FAILURE_LIMIT=3

# Save cache and resume state every N successful new translations
SAVE_PROGRESS_EVERY_N=20

# Enable resume state by default
RESUME_ENABLED=true
